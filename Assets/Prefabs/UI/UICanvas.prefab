--- !u!114 &4898078858960735394
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8842276410967783726}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 18bca0f95fb2d6f43ad429894492277c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialoguePanel: {fileID: 8317910969357489971}
  dialogueText: {fileID: 7179533731562259343}
  headingText: {fileID: 5156879060016321988}
  skipReminderText: {fileID: 6930425975256654737}
  characterImage: {fileID: 6311787004636708952}
  imageContainer: {fileID: 2963369833459151671}
  delayBetweenLines: 4
  dialogueCompleted: 0
  houseClean: 0
  foundDivorcePapers: 0
  hud: {fileID: 4607640005946366050}
  cursor: {fileID: 0}
  loadNextScene: Scene_EndDemo
  startDialogue:
  - text: '[Wednesday]'
    heading: 
    characterSprite: {fileID: 0}
    spriteOnRight: 1
  - text: Door clicks shut
    heading: 
    characterSprite: {fileID: 0}
    spriteOnRight: 1
  - text: And they're off again...
    heading: Ghost
    characterSprite: {fileID: 21300000, guid: 9bd23ff6432ed5741a9e5fe6893dd073, type: 3}
    spriteOnRight: 1
  - text: Seriously, after all this time, they really can't be bothered to clean
      up after themselves?
    heading: Ghost
    characterSprite: {fileID: 21300000, guid: 0763b23136dcec94f8954c039cb47e6c, type: 3}
    spriteOnRight: 1
  - text: ...
    heading: Ghost
    characterSprite: {fileID: 21300000, guid: 9bd23ff6432ed5741a9e5fe6893dd073, type: 3}
    spriteOnRight: 1
  - text: Whatever. Let's get to work then. Can't have this place looking like a
      pig's sty
    heading: Ghost
    characterSprite: {fileID: 21300000, guid: 9bd23ff6432ed5741a9e5fe6893dd073, type: 3}
    spriteOnRight: 1
  endDialogueGood:
  - text: '[The room looks considerably cleaner than before]'
    heading: 
    characterSprite: {fileID: 0}
    spriteOnRight: 1
  - text: All in a day's work!
    heading: Ghost
    characterSprite: {fileID: 21300000, guid: 4b5e16b0784ca114d94f01c42002f6ca, type: 3}
    spriteOnRight: 1
  - text: Gosh, how would they survive without me?
    heading: Ghost
    characterSprite: {fileID: 21300000, guid: 4b5e16b0784ca114d94f01c42002f6ca, type: 3}
    spriteOnRight: 1
  endDialogueBad:
  - text: '[The room looks better but is still visibily cluttered]'
    heading: 
    characterSprite: {fileID: 0}
    spriteOnRight: 0
  - text: Why is it always a pig sty around here?
    heading: Ghost
    characterSprite: {fileID: 21300000, guid: 0763b23136dcec94f8954c039cb47e6c, type: 3}
    spriteOnRight: 1
  - text: They can't keep expecting me to clean up after them
    heading: Ghost
    characterSprite: {fileID: 21300000, guid: 0763b23136dcec94f8954c039cb47e6c, type: 3}
    spriteOnRight: 1
  endDialogueFoundDivorcePapers:
  - text: Speaking of which...
    heading: Ghost
    characterSprite: {fileID: 21300000, guid: fc7118460acedc64e8bef5a9dc866966, type: 3}
    spriteOnRight: 1
  - text: Those papers... Are they really-
    heading: Ghost
    characterSprite: {fileID: 21300000, guid: fc7118460acedc64e8bef5a9dc866966, type: 3}
    spriteOnRight: 1
  - text: No. It's not my problem. The day is finished
    heading: Ghost
    characterSprite: {fileID: 21300000, guid: 9bd23ff6432ed5741a9e5fe6893dd073, type: 3}
    spriteOnRight: 1
